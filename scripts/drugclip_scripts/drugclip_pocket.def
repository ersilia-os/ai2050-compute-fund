# Apptainer definition file for DrugCLIP pocket encoding
#
# Bundles the Drug-The-Whole-Genome repo (unimol/ + dict/).
# Model weights are NOT baked in — they are bind-mounted at runtime from
#   /shared/drugclip-weights  →  /drugclip/data/model_weights
# Uses the SAME 6-fold checkpoints as the molecule encoder (6_folds/fold_{i}.pt).
# NOTE: --path arg is required by the parser but ignored at runtime; checkpoints
#       are loaded directly from ./data/model_weights/6_folds/ relative to CWD.
#
# Build (from repo root):
#   apptainer build drugclip_pocket.sif scripts/drugclip_scripts/drugclip_pocket.def
#
# Upload to S3:
#   aws s3 cp drugclip_pocket.sif s3://ai2050-ersilia-cluster/sif-files/drugclip_pocket.sif

Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu20.04

# ── Bundle local files into the container ─────────────────────────────────────
# Paths are relative to the directory where `apptainer build` is run (repo root)
%files
    Drug-The-Whole-Genome/unimol    /drugclip/unimol
    Drug-The-Whole-Genome/dict      /drugclip/dict

# ── Build steps ───────────────────────────────────────────────────────────────
%post
    export DEBIAN_FRONTEND=noninteractive

    # System packages
    apt-get update -y && apt-get install -y \
        git wget curl bzip2 ca-certificates \
        libglib2.0-0 libxext6 libsm6 libxrender1 \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

    # ── Miniforge (Python 3.9, conda-forge — no Anaconda ToS) ─────────────
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
        -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/miniconda
    rm /tmp/miniforge.sh

    export PATH="/opt/miniconda/bin:$PATH"
    mamba install -y python=3.9

    # ── PyTorch 2.1.2 + CUDA 12.1 ──────────────────────────────────────────
    pip install --no-cache-dir \
        torch==2.1.2 torchvision==0.16.2 \
        --index-url https://download.pytorch.org/whl/cu121

    # ── RDKit ───────────────────────────────────────────────────────────────
    pip install --no-cache-dir rdkit==2022.9.5

    # ── Core scientific packages ────────────────────────────────────────────
    pip install --no-cache-dir \
        "numpy<2" scipy scikit-learn \
        lmdb \
        h5py \
        tqdm \
        biopython \
        pandas

    # ── Uni-Core (fairseq-based framework required by DrugCLIP) ────────────
    pip install --no-cache-dir \
        git+https://github.com/dptech-corp/Uni-Core.git

    # ── Place pocket dictionary where data loader expects it ─────────────────
    mkdir -p /drugclip/data
    cp /drugclip/dict/dict_pkt.txt /drugclip/data/dict_pkt.txt

    # ── Placeholder for bind-mounted weights (same 6-fold checkpoints as molecule encoder) ──
    mkdir -p /drugclip/data/model_weights/6_folds

    # ── Make unimol importable ───────────────────────────────────────────────
    echo '/drugclip' > $(python -c "import site; print(site.getsitepackages()[0])")/drugclip.pth

    # Clean conda cache
    conda clean -afy

# ── Runtime environment ───────────────────────────────────────────────────────
%environment
    export PATH="/opt/miniconda/bin:$PATH"
    export PYTHONPATH="/drugclip:$PYTHONPATH"
    export TOKENIZERS_PARALLELISM=false

# ── Default: run python from /drugclip working directory ─────────────────────
%runscript
    cd /drugclip
    exec python "$@"

# ── Labels ────────────────────────────────────────────────────────────────────
%labels
    Author ersilia
    Version 1.0
    Description DrugCLIP pocket embedding extraction (6 folds × 128-dim vectors per pocket)
